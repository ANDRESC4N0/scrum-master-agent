# ── Notion ─────────────────────────────────────────────────────
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxx
NOTION_DB_TAREAS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Workspace local ────────────────────────────────────────────
# Ruta absoluta a la carpeta raíz del workspace
BASE_PATH=/ruta/a/tu/workspace

# ── Estándares de arquitectura ────────────────────────────────
# Carpeta dentro de BASE_PATH con archivos .md que definen reglas
# de arquitectura por stack/tipo (ej: golang_architecture_monolith.md).
# Los agentes los leen para garantizar estándares al implementar proyectos nuevos.
# Si no se define, busca en BASE_PATH/_standards/
STANDARDS_DIR=_standards

# ── Rama base ─────────────────────────────────────────────────
# Rama contra la cual se valida que los proyectos estén actualizados
# antes de implementar. El agente hace fetch + checkout + pull de esta
# rama para garantizar que el desarrollo sea sobre código vigente.
RAMA_BASE=main

# ── Opcionales ─────────────────────────────────────────────────
# Límite de tareas a procesar por ejecución (sin límite si no se define)
# MAX_TAREAS_POR_EJECUCION=5
