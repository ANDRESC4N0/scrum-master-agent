# ── Notion ─────────────────────────────────────────────────────
# Token de integración interna → https://www.notion.so/my-integrations
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxx

# IDs de las bases de datos (UUID sin guiones)
NOTION_DB_EPICAS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DB_IDEAS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DB_TAREAS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Workspace local ────────────────────────────────────────────
# Ruta absoluta a la carpeta raíz donde viven los proyectos.
# Las rutas de las ideas son relativas a esta.
# Windows: C:\documentos\work
# Mac/Linux: /Users/andres/work
BASE_PATH=/ruta/a/tu/workspace

# ── Estándares de arquitectura ────────────────────────────────
# Carpeta dentro de BASE_PATH con archivos .md que definen reglas
# de arquitectura por stack/tipo (ej: golang_architecture_monolith.md).
# Los agentes los leen para garantizar estándares al crear proyectos nuevos.
# Si no se define, busca en BASE_PATH/_standards/
STANDARDS_DIR=_standards

# ── Rama base ─────────────────────────────────────────────────
# Rama contra la cual se valida que los proyectos estén actualizados
# antes de analizar el código. El agente hace fetch + checkout + pull
# de esta rama para garantizar que el análisis sea sobre código vigente.
RAMA_BASE=main

# ── Opcionales ─────────────────────────────────────────────────
# Límite de ideas a procesar por ejecución (sin límite si no se define)
# MAX_IDEAS_POR_EJECUCION=3
