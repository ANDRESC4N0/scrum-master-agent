# ── Notion ─────────────────────────────────────────────────────
# Token de integración interna → https://www.notion.so/my-integrations
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxx

# IDs de las bases de datos (UUID sin guiones)
NOTION_DB_EPICAS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DB_IDEAS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DB_TAREAS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Workspace local ────────────────────────────────────────────
# Ruta absoluta a la carpeta raíz donde viven todos los proyectos
# y el CLAUDE.md global. Las rutas de las ideas son relativas a esta.
# Windows: C:\documentos\work
# Mac/Linux: /Users/andres/work
BASE_PATH=/ruta/a/tu/workspace

# ── Opcionales ─────────────────────────────────────────────────
# Límite de ideas a procesar por ejecución (sin límite si no se define)
# MAX_IDEAS_POR_EJECUCION=3
